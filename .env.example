# Copia este archivo como .env y completa tu clave. No subas .env a git.
# GOOGLE_API_KEY=

# Modelo que redacta las respuestas del chatbot
# GEMINI_MODEL=

# Opcional: cambia el modelo de embeddings por defecto
# EMBEDDINGS_MODEL=

# Opcional: modelo local sin clave (requiere instalar requirements-local.txt)
# EMBEDDINGS_PROVIDER=sentence-transformers
