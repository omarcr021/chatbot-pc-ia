# Copia este archivo como .env y completa los valores. No subas .env a git.

# Proveedor de embeddings: sentence-transformers (sin clave) o gemini
EMBEDDINGS_PROVIDER=sentence-transformers

# Opcional: cambia el modelo por defecto del proveedor
# EMBEDDINGS_MODEL=

# Solo si EMBEDDINGS_PROVIDER=gemini
GOOGLE_API_KEY=
